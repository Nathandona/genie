{
  "name": "@genie/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "npx tsup src/server.ts --format esm --splitting false --sourcemap",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:format": "npx prisma format"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@genie/ai-services": "workspace:^",
    "@genie/analyzer": "workspace:^",
    "@genie/crawler": "workspace:^",
    "@genie/generator": "workspace:^",
    "@genie/shared": "workspace:^",
    "@polar-sh/sdk": "^0.41.1",
    "@prisma/client": "^6.19.0",
    "@types/node": "^24.10.0",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.63.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.8.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^6.19.0",
    "tsup": "^8.5.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
