{
  "name": "@genie/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "npx tsup src/server.ts --format esm --splitting false --sourcemap",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:format": "npx prisma format"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/rate-limit": "^9.0.1",
    "@genie/ai-services": "workspace:^0.1.0",
    "@genie/analyzer": "workspace:^0.1.0",
    "@genie/crawler": "workspace:^0.1.0",
    "@genie/generator": "workspace:^0.1.0",
    "@genie/shared": "workspace:^0.1.0",
    "@polar-sh/sdk": "^0.41.1",
    "@prisma/client": "^5.20.0",
    "@types/node": "^20.14.9",
    "archiver": "^7.0.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.13.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.8.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.1",
    "prisma": "^5.20.0",
    "tsup": "^8.1.0",
    "yauzl": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
