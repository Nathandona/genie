{
  "name": "@genie/crawler",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format esm,cjs --dts",
    "dev": "npx tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@genie/shared": "workspace:^0.1.0",
    "@sparticuz/chromium": "^141.0.0",
    "@types/node": "^20.14.9",
    "cheerio": "^1.0.0",
    "p-queue": "^7.4.1",
    "puppeteer": "^23.3.0",
    "puppeteer-core": "^24.29.1",
    "tsup": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
