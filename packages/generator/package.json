{
  "name": "@genie/generator",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@genie/analyzer": "workspace:^0.1.0",
    "@genie/shared": "workspace:^0.1.0",
    "fs-extra": "^11.2.0",
    "mustache": "^4.2.0",
    "prettier": "^3.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mustache": "^4.2.6",
    "eslint": "^9.9.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
