{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api",
      "has": [
        {
          "type": "header",
          "key": "x-internal-request",
          "value": "true"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  }
}

